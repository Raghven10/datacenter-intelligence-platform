# Application Configuration
APP_ENV=production
DEBUG=False
PORT=8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=di_user
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=di_database

# Construct full DSN (or use individual vars above)
# POSTGRES_DSN=postgresql://di_user:your-secure-password-here@localhost:5432/di_database

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
UPLOAD_DIR=app/static/profile_pics
MAX_UPLOAD_SIZE_MB=5
